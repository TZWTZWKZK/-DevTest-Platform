{
  "name": "product-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon",
    "dev:once": "kill-port 3000 && node -r ./skywalking.cjs ./node_modules/next/dist/bin/next dev --turbopack -p 3000",
    "build": "next build",
    "start": "node -r ./skywalking.cjs ./node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate:sqlite-to-mysql": "node scripts/migrate-sqlite-to-mysql.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "mysql2": "^3.20.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "skywalking-backend-js": "^0.8.0",
    "sql.js": "^1.14.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.2.0",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.14",
    "postcss": "^8",
    "prisma": "^6.6.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
